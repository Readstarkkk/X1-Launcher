function toast(message){const el=$('toast');el.textContent=message;el.classList.add('show');clearTimeout(toast.timer);toast.timer=setTimeout(()=>el.classList.remove('show'),2600)}
function safeRead(key,fallback){try{return JSON.parse(localStorage.getItem(key)||JSON.stringify(fallback))}catch(_){return fallback}}
function appIcon(app){if(app.iconData&&String(app.iconData).startsWith('data:image/')){const img=document.createElement('img');img.src=app.iconData;img.alt='';return img;}const span=document.createElement('span');if(app.catalog){span.className='planet';span.textContent='🪐';}else{span.className='letter';span.textContent=(app.name||'X').trim().slice(0,1).toUpperCase();}return span}
function makeCard(app){const card=document.createElement('div');card.className='app-card';const button=document.createElement('button');button.type='button';button.className='app-card';button.setAttribute('aria-label',app.name||'Aplicativo');const icon=document.createElement('span');icon.className='iconbox';icon.appendChild(appIcon(app));button.appendChild(icon);const name=document.createElement('span');name.className='app-name';name.textContent=app.name||'App';button.appendChild(name);if(app.sub){const sub=document.createElement('small');sub.className='app-sub';sub.textContent=app.sub;button.appendChild(sub)}button.addEventListener('click',()=>{if(app.packageName){let ok=false;try{ok=!!(window.X1&&window.X1.launchApp(app.packageName))}catch(_){}if(ok){recordRecent(app);toast('Abrindo '+app.name+'…')}else toast('Não foi possível abrir '+app.name+'.')}else if(app.url){let ok=false;try{ok=!!(window.X1&&window.X1.openExternal(app.url))}catch(_){}if(!ok){try{window.location.href=app.url}catch(_){toast('Não foi possível abrir o link.')}}}});card.appendChild(button);if(app.packageName){const gear=document.createElement('button');gear.type='button';gear.className='gear';gear.textContent='⚙';gear.setAttribute('aria-label','Perfil de '+app.name);gear.addEventListener('click',e=>{e.stopPropagation();openProfile(app)});card.appendChild(gear)}return card}
function renderRail(id,list){const node=$(id);node.replaceChildren();if(!list.length){const e=document.createElement('div');e.className='empty';e.textContent=id==='recentRail'?'Você ainda não abriu apps pelo X1.':'Nenhum aplicativo foi encontrado.';node.appendChild(e);return}list.forEach(app=>node.appendChild(makeCard(app)))}
function recordRecent(app){const list=safeRead('x1RecentApps',[]).filter(x=>x.packageName!==app.packageName);list.unshift({name:app.name,packageName:app.packageName,iconData:app.iconData||'',sub:'Aberto recentemente'});try{localStorage.setItem('x1RecentApps',JSON.stringify(list.slice(0,10)))}catch(_){}renderRail('recentRail',safeRead('x1RecentApps',[]))}
function refreshInstalled(){const rail=$('installedRail');rail.replaceChildren();const loading=document.createElement('div');loading.className='empty';loading.textContent='Lendo aplicativos instalados...';rail.appendChild(loading);setTimeout(()=>{try{if(!window.X1||!window.X1.getInstalledApps){renderRail('installedRail',[]);toast('Esta versão não expõe a lista de apps Android.');return}const apps=JSON.parse(window.X1.getInstalledApps()||'[]').map(a=>({name:a.name,packageName:a.packageName,iconData:a.iconData||'',isGame:!!a.isGame,sub:a.isGame?'Jogo instalado':'App instalado'}));renderRail('installedRail',apps)}catch(e){renderRail('installedRail',[]);toast('Erro ao carregar os aplicativos.')}} ,0)}
function renderPorts(){renderRail('portsRail',ports.map(p=>({...p,catalog:true})));$('allPortsGrid').replaceChildren();ports.forEach(p=>$('allPortsGrid').appendChild(makeCard({...p,catalog:true})))}
function openProfile(app){activeProfile=app;$('profileAppName').textContent=app.name+' · '+app.packageName;const all=safeRead('x1Profiles',{}),p=all[app.packageName]||{preset:'Performance',resolution:'1080p',autoResolution:false};$('profilePreset').value=p.preset;$('profileResolution').value=p.resolution;$('profileAutoResolution').checked=p.autoResolution===true;$('profileModal').classList.add('open')}
function saveProfile(){if(!activeProfile)return;const p=safeRead('x1Profiles',{});p[activeProfile.packageName]={preset:$('profilePreset').value,resolution:$('profileResolution').value,autoResolution:$('profileAutoResolution').checked};try{localStorage.setItem('x1Profiles',JSON.stringify(p))}catch(_){}closeModal('profileModal');toast('Preferências salvas para '+activeProfile.name+'.')}
function restoreResolutionNow(){if(!window.X1||!window.X1.restoreOriginalResolution){toast('Esta versão do APK não oferece restauração de resolução. Gere e instale o APK atualizado.');return}try{window.X1.restoreOriginalResolution();toast('Solicitação de restauração enviada.')}catch(e){toast('Não foi possível solicitar a restauração.') }}
function closeModal(id){$(id).classList.remove('open')}
function setWallpaper(data,save=true){document.body.style.backgroundImage='linear-gradient(rgba(8,6,15,.76),rgba(8,6,15,.9)),url("'+data+'")';document.body.style.backgroundSize='cover';document.body.style.backgroundPosition='center';if(save){try{localStorage.setItem('x1Wallpaper',JSON.stringify(data))}catch(_){toast('Imagem grande demais para salvar; use uma imagem menor.')}}}
function loadSettings(){const s=safeRead('x1Settings',{});$('motionToggle').checked=s.motion!==false;$('glowRange').value=s.glow||70;$('labelsToggle').checked=s.labels!==false;applySettings();let wall='';try{wall=JSON.parse(localStorage.getItem('x1Wallpaper')||'""')}catch(_){}if(wall)setWallpaper(wall,false)}
function applySettings(){const s={motion:$('motionToggle').checked,glow:Number($('glowRange').value),labels:$('labelsToggle').checked};document.body.classList.toggle('no-motion',!s.motion);document.body.classList.toggle('labels-hidden',!s.labels);document.documentElement.style.setProperty('--line','rgba(168,85,247,'+(0.12+s.glow/180)+')');document.documentElement.style.setProperty('--glow','0 0 '+Math.round(s.glow/3)+'px rgba(168,85,247,'+(s.glow/500)+')')}
function saveSettings(){const s={motion:$('motionToggle').checked,glow:Number($('glowRange').value),labels:$('labelsToggle').checked};try{localStorage.setItem('x1Settings',JSON.stringify(s))}catch(_){}applySettings();closeModal('settingsModal');toast('Configurações salvas.')}
function resetSettings(){try{localStorage.removeItem('x1Settings');localStorage.removeItem('x1Wallpaper')}catch(_){}document.body.style.backgroundImage='';document.body.style.backgroundSize='';$('motionToggle').checked=true;$('glowRange').value=70;$('labelsToggle').checked=true;applySettings();toast('Aparência restaurada.');}
function chooseWallpaper(file){if(!file)return;const reader=new FileReader();reader.onload=()=>{const image=new Image();image.onload=()=>{const canvas=document.createElement('canvas');const scale=Math.min(1,1200/Math.max(image.width,image.height));canvas.width=Math.round(image.width*scale);canvas.height=Math.round(image.height*scale);canvas.getContext('2d').drawImage(image,0,0,canvas.width,canvas.height);setWallpaper(canvas.toDataURL('image/jpeg',.78));toast('Papel de parede atualizado.')} ;image.onerror=()=>toast('Não foi possível abrir essa imagem.');image.src=reader.result};reader.onerror=()=>toast('Não foi possível ler a imagem.');reader.readAsDataURL(file)}
$('openAdvanced').addEventListener('click',openAdvanced);$('checkRoot').addEventListener('click',checkRoot);$('grantUsage').addEventListener('click',()=>{try{if(window.X1&&window.X1.openUsageAccessSettings)window.X1.openUsageAccessSettings();else toast('Abra o Acesso ao uso nas configurações do Android.')}catch(_){toast('Não foi possível abrir a permissão.')}});$('refreshUsage').addEventListener('click',()=>{refreshDeviceStats();renderUsageChart()});document.querySelectorAll('[data-system-setting]').forEach(b=>b.addEventListener('click',()=>openSystemSetting(b.dataset.systemSetting)));$('clearRecent').addEventListener('click',()=>{try{localStorage.removeItem('x1RecentApps')}catch(_){}renderRail('recentRail',[]);toast('Histórico apagado.')});$('refreshInstalled').addEventListener('click',refreshInstalled);$('viewPorts').addEventListener('click',()=>$('allPortsModal').classList.add('open'));$('openSettings').addEventListener('click',()=>$('settingsModal').classList.add('open'));document.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',()=>closeModal(b.dataset.close)));document.querySelectorAll('.modal-backdrop').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('open')}));document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll('.modal-backdrop.open').forEach(close=>close.classList.remove('open'))});$('saveProfile').addEventListener('click',saveProfile);$('saveSettings').addEventListener('click',saveSettings);$('resetSettings').addEventListener('click',resetSettings);$('chooseWallpaper').addEventListener('click',()=>$('wallpaperInput').click());$('wallpaperInput').addEventListener('change',e=>chooseWallpaper(e.target.files&&e.target.files[0]));$('glowRange').addEventListener('input',applySettings);

function formatBytes(value){if(!Number.isFinite(Number(value))||Number(value)<0)return '—';const units=['B','KB','MB','GB','TB'];let n=Number(value),i=0;while(n>=1024&&i<units.length-1){n/=1024;i++}return (i===0?Math.round(n):n.toFixed(1))+' '+units[i]}
function refreshDeviceStats(){try{if(!window.X1||!window.X1.getDeviceStats){$('ramValue').textContent='Indisponível';$('storageValue').textContent='Indisponível';$('ramDetail').textContent='Requer a versão Android do X1';$('storageDetail').textContent='Requer a versão Android do X1';return}const d=JSON.parse(window.X1.getDeviceStats()||'{}');if(!d.ok)throw new Error('stats');$('ramValue').textContent=formatBytes(d.ramUsed)+' / '+formatBytes(d.ramTotal);$('ramDetail').textContent=formatBytes(d.ramAvailable)+' disponíveis';$('storageValue').textContent=formatBytes(d.storageAvailable);$('storageDetail').textContent='de '+formatBytes(d.storageTotal)+' no armazenamento';}catch(_){$('ramValue').textContent='Indisponível';$('storageValue').textContent='Indisponível';$('ramDetail').textContent='Não foi possível consultar';$('storageDetail').textContent='Não foi possível consultar'}}
function refreshUsageStatus(){try{const ok=!!(window.X1&&window.X1.hasUsageAccess&&window.X1.hasUsageAccess());$('usageStatus').textContent=ok?'Permissão concedida. O gráfico pode consultar até 7 dias de uso.':'Permissão não concedida. Toque em “Permitir acesso ao uso” e habilite o X1 nas configurações do Android.';return ok}catch(_){$('usageStatus').textContent='Esta versão Android não disponibiliza a consulta de uso.';return false}}
function renderUsageChart(){const node=$('usageChart');node.replaceChildren();if(!window.X1||!window.X1.getUsageStats){node.textContent='Recurso disponível somente no APK Android atualizado.';return}if(!refreshUsageStatus()){const m=document.createElement('div');m.className='empty';m.textContent='Conceda a permissão de Acesso ao uso para mostrar o gráfico.';node.appendChild(m);return}try{const result=JSON.parse(window.X1.getUsageStats()||'{}');if(!result.authorized){const m=document.createElement('div');m.className='empty';m.textContent='O Android ainda não liberou os dados. Verifique a permissão e tente novamente.';node.appendChild(m);return}const apps=Array.isArray(result.apps)?result.apps:[];if(!apps.length){const m=document.createElement('div');m.className='empty';m.textContent='Nenhum tempo de uso foi retornado nos últimos 7 dias.';node.appendChild(m);return}const max=Math.max(1,...apps.map(a=>Number(a.millis)||0));apps.slice(0,10).forEach(app=>{const item=document.createElement('div');item.className='usage-item';const label=document.createElement('div');label.className='usage-label';const name=document.createElement('span');name.textContent=app.name||app.packageName||'Aplicativo';const time=document.createElement('span');const mins=Math.round((Number(app.millis)||0)/60000);time.textContent=mins>=60?Math.floor(mins/60)+' h '+(mins%60)+' min':mins+' min';label.append(name,time);const track=document.createElement('div');track.className='usage-track';const fill=document.createElement('div');fill.className='usage-fill';fill.style.width=Math.max(1,((Number(app.millis)||0)/max)*100)+'%';track.appendChild(fill);item.append(label,track);node.appendChild(item)})}catch(_){const m=document.createElement('div');m.className='empty';m.textContent='Não foi possível ler as estatísticas de uso.';node.appendChild(m)}}
function openAdvanced(){$('advancedModal').classList.add('open');refreshDeviceStats();refreshUsageStatus();renderUsageChart()}
function rootCheckResult(ok,message){const el=$('rootStatus');el.textContent=message;el.style.color=ok?'#a7f3d0':'var(--muted)';$('checkRoot').textContent=ok?'Verificar novamente':'Verificar acesso root'}
