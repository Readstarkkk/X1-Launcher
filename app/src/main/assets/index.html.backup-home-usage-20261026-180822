$("refreshSystemMetrics").addEventListener("click",refreshSystemPage);
$("openWirelessDebugging").addEventListener("click",()=>{try{if(window.X1&&window.X1.openDeveloperSettings&&window.X1.openDeveloperSettings()){$("wirelessStatus").textContent="Opções do desenvolvedor abertas. Na tela do Android, habilite Depuração sem fio e use o pareamento oferecido pelo próprio sistema."}else toast("Não foi possível abrir as opções do desenvolvedor.")}catch(_){toast("Não foi possível abrir as opções do desenvolvedor.")}});
$("adbNotifyPairButton").addEventListener("click",()=>{if(!window.X1||!window.X1.startAutomaticAdbPairing){toast("Recurso disponível no APK Android atualizado.");return}try{$("wirelessStatus").textContent="Preparando notificação de pareamento…";window.X1.startAutomaticAdbPairing()}catch(_){toast("Não foi possível preparar a notificação.")}});
$("adbPairButton").addEventListener("click",adbPairRequest);$("adbConnectButton").addEventListener("click",adbConnectRequest);$("adbForgetPairingButton").addEventListener("click",adbForgetPairingState);
$("wirelessHelp").addEventListener("click",()=>{$("wirelessStatus").textContent="1) Ative Depuração sem fio. 2) Toque em Parear dispositivo com código e mantenha a janela aberta. 3) No X1, toque em Parear pela notificação. 4) Responda ao aviso do X1 com o código de 6 dígitos. O X1 tentará descobrir automaticamente IP e portas via mDNS. Se o Android não anunciar o serviço, abra Configuração manual / avançada.";});
$("systemBackToApps").addEventListener("click",()=>x1PageChange("appsPage"));
function setAdbBusy(busy){$('adbPairButton').disabled=busy;$('adbConnectButton').disabled=busy;}
function renderAdbPairingState(state){
 const paired=!!(state&&state.paired);
 $('adbPairedBanner').hidden=!paired;
 $('adbPairPanel').hidden=paired;
 if(!paired){$('wirelessStatus').style.color='';return;}
 const host=String(state.host||'').trim();
 $('adbPairedDescription').textContent=(host?'O pareamento deste dispositivo ('+host+') foi salvo no X1. ':'O pareamento foi salvo no X1. ')+ 'Esse estado permanece ao sair e voltar ao aplicativo. A conexão ADB ativa pode precisar ser refeita se a Depuração sem fio for desligada ou o Android reiniciar.';
 $('wirelessStatus').textContent='✓ Pareamento ADB salvo neste aplicativo.'+(host?' Dispositivo: '+host+'.':'')+' O estado da conexão ativa é separado.';
 $('wirelessStatus').style.color='#86efac';
}
window.x1RefreshAdbPairingState=function(){
 try{if(!window.X1||!window.X1.getAdbPairingState)return;renderAdbPairingState(JSON.parse(window.X1.getAdbPairingState()||'{}'));}
 catch(e){console.warn('Não foi possível consultar o estado do pareamento ADB.',e);}
};
function adbForgetPairingState(){
 try{
  if(!window.X1||!window.X1.forgetAdbPairingState){toast('Atualize o APK para alterar o estado do pareamento.');return;}
  window.X1.forgetAdbPairingState();
  renderAdbPairingState({paired:false});
  $('wirelessStatus').textContent='Estado local do pareamento removido. Isso não revoga a autorização ADB nas configurações do Android.';
  toast('Estado salvo removido.');
 }catch(e){toast('Não foi possível alterar o estado salvo.');}
}
window.onX1AdbPairResult=function(success,message,connected){setAdbBusy(false);const el=$('wirelessStatus');el.textContent=(success?'✓ ':'✕ ')+message+(connected?' Estado: conectado.':'');el.style.color=success?'#d7ffd9':'#ffd0dc';if(success&&window.x1RefreshAdbPairingState)window.x1RefreshAdbPairingState();if(!success)toast(message)};
function adbPairRequest(){const host=$('adbHost').value.trim();const pairPort=Number($('adbPairPort').value);const code=$('adbPairCode').value.trim();const connectPort=Number($('adbConnectPort').value||0);if(!host||!pairPort||!/^[0-9]{6}$/.test(code)){toast('Preencha IP, porta de pareamento e código de 6 dígitos.');return}if(!window.X1||!window.X1.pairWirelessDebugging){toast('Este APK não expõe a integração ADB. Instale o APK gerado após esta correção.');return}setAdbBusy(true);$('wirelessStatus').textContent='Tentando parear com '+host+':'+pairPort+'…';try{window.X1.pairWirelessDebugging(host,pairPort,code,connectPort)}catch(e){setAdbBusy(false);toast('Não foi possível iniciar o pareamento ADB.');$('wirelessStatus').textContent='Falha ao iniciar o pareamento.'}}
function adbConnectRequest(){const host=$('adbHost').value.trim();const port=Number($('adbConnectPort').value);if(!host||!port){toast('Preencha IP e porta de conexão.');return}if(!window.X1||!window.X1.connectWirelessDebugging){toast('Este APK não expõe a integração ADB. Instale o APK gerado após esta correção.');return}setAdbBusy(true);$('wirelessStatus').textContent='Conectando ao dispositivo já pareado…';try{window.X1.connectWirelessDebugging(host,port)}catch(e){setAdbBusy(false);toast('Não foi possível iniciar a conexão ADB.');$('wirelessStatus').textContent='Falha ao iniciar a conexão.'}}

function initialize(){try{renderPorts();renderRail('recentRail',safeRead('x1RecentApps',[]));loadSettings();refreshInstalled();if(window.x1RefreshAdbPairingState)window.x1RefreshAdbPairingState()}catch(e){console.error('X1 initialization failed',e);toast('A interface carregou com limitações.')}}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initialize,{once:true});else initialize();
</script>
</body></html>
