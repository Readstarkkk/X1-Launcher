function checkRoot(){const el=$('rootStatus');el.textContent='Verificando acesso privilegiado…';el.style.color='var(--muted)';$('checkRoot').disabled=true;try{if(window.X1&&window.X1.checkRoot){window.X1.checkRoot()}else{rootCheckResult(false,'Verificação de root disponível somente no APK Android atualizado.')}}catch(_){rootCheckResult(false,'Não foi possível iniciar a verificação de root.')}setTimeout(()=>$('checkRoot').disabled=false,5500)}
function openSystemSetting(name){try{if(window.X1&&window.X1.openSystemSettings&&window.X1.openSystemSettings(name))return;toast('Atalho de sistema indisponível nesta versão.')}catch(_){toast('Não foi possível abrir essa configuração.')}}


function x1PageChange(pageId){
  document.querySelectorAll('[data-x1page]').forEach(btn=>{const selected=btn.dataset.x1page===pageId;btn.classList.toggle('active',selected);btn.setAttribute('aria-pressed',selected?'true':'false')});
  document.querySelectorAll('.page').forEach(page=>page.classList.toggle('active',page.id===pageId));
  if(pageId==='systemPage')refreshSystemPage();
}
function detectWebViewGpu(){try{const canvas=document.createElement('canvas');const gl=canvas.getContext('webgl')||canvas.getContext('experimental-webgl');if(!gl)return 'Não informado pelo WebView';const ext=gl.getExtension('WEBGL_debug_renderer_info');const value=ext?gl.getParameter(ext.UNMASKED_RENDERER_WEBGL):gl.getParameter(gl.RENDERER);return value||'Não informado pelo WebView'}catch(_){return 'Não disponível'}}
function refreshSystemPage(){
  $('systemGpuValue').textContent=detectWebViewGpu();
  try{if(window.X1&&window.X1.getDeviceStats){const d=JSON.parse(window.X1.getDeviceStats()||'{}');if(d.ok){$('systemRamValue').textContent=formatBytes(d.ramUsed)+' / '+formatBytes(d.ramTotal);$('systemRamDetail').textContent=formatBytes(d.ramAvailable)+' disponíveis';$('systemStorageValue').textContent=formatBytes(d.storageAvailable);$('systemStorageDetail').textContent='de '+formatBytes(d.storageTotal)+' totais'}else throw new Error('stats')}else throw new Error('bridge')}catch(_){$('systemRamValue').textContent='Indisponível';$('systemStorageValue').textContent='Indisponível';$('systemRamDetail').textContent='Requer o APK Android atualizado';$('systemStorageDetail').textContent='Requer o APK Android atualizado'}
  try{if(window.X1&&window.X1.getSystemInfo){const d=JSON.parse(window.X1.getSystemInfo()||'{}');$('systemDeviceValue').textContent=[d.manufacturer,d.model].filter(Boolean).join(' ')||'Não informado';$('systemAndroidValue').textContent='Android '+(d.android||'—')+' · API '+(d.sdk||'—');$('systemCpuValue').textContent=d.cpu||d.hardware||'Não informado';$('systemAbiValue').textContent='ABI: '+(d.abi||'—');$('systemTempValue').textContent=(typeof d.batteryTempC==='number')?d.batteryTempC.toFixed(1)+' °C':'Indisponível'}else throw new Error('bridge')}catch(_){$('systemDeviceValue').textContent='Indisponível';$('systemAndroidValue').textContent='Requer o APK atualizado';$('systemCpuValue').textContent='Indisponível';$('systemAbiValue').textContent='ABI: —';$('systemTempValue').textContent='Indisponível'}
}

