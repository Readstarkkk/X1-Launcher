<title>X1 Launcher</title>
<style>
:root{color-scheme:dark;--bg:#08060f;--panel:#120c1d;--panel2:#191027;--purple:#a855f7;--bright:#d8a4ff;--text:#f8f4ff;--muted:#a69ab9;--line:rgba(168,85,247,.38);--glow:0 0 24px rgba(168,85,247,.14)}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:var(--bg);color:var(--text);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}body{min-height:100vh;background:radial-gradient(ellipse at 50% -18%,rgba(103,45,194,.22),transparent 48%),var(--bg);overflow-x:hidden}button,input,select{font:inherit}button{color:inherit;cursor:pointer}button:focus-visible,input:focus-visible,select:focus-visible{outline:2px solid var(--bright);outline-offset:3px}.frame{max-width:1180px;margin:auto;padding:20px clamp(14px,4vw,42px) 30px;min-height:100vh;position:relative}header{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:26px}.brand{display:flex;align-items:center;gap:12px}.brand-mark{font-size:38px;font-weight:1000;font-style:italic;letter-spacing:-.12em;color:#eedaff;text-shadow:0 0 22px #963ee8;padding-right:5px}.brand-title{font-weight:850;letter-spacing:.04em}.brand-sub{font-size:10px;letter-spacing:.22em;color:var(--muted);margin-top:3px}.status{border:1px solid var(--line);border-radius:999px;padding:8px 11px;font-size:11px;color:#d7c4e8;background:#120b1d;white-space:nowrap}.status i{display:inline-block;width:7px;height:7px;background:#b15cff;border-radius:50%;margin-right:7px;box-shadow:0 0 9px #b15cff}main{position:relative;z-index:1}.section{margin:0 0 25px}.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:11px}.section-title{font-size:clamp(17px,2.7vw,22px);font-weight:760;letter-spacing:-.025em}.section-title .emoji{color:var(--bright);margin-right:8px}.link-button{background:none;border:0;color:var(--bright);font-size:13px;padding:8px 0}.note{margin:0 0 10px;font-size:12px;line-height:1.5;color:var(--muted)}.rail-wrap{border:1px solid var(--line);border-radius:20px;padding:13px;background:linear-gradient(120deg,rgba(25,15,39,.92),rgba(10,7,17,.93));box-shadow:var(--glow)}.rail{display:flex;gap:14px;overflow-x:auto;padding:2px 2px 8px;scrollbar-width:thin;scrollbar-color:#64329c transparent}.rail::-webkit-scrollbar{height:5px}.rail::-webkit-scrollbar-thumb{background:#64329c;border-radius:10px}.empty{font-size:12px;color:var(--muted);padding:10px 3px;line-height:1.5}.app-card{width:96px;flex:0 0 96px;min-width:0;position:relative;text-align:center;border:0;background:none;padding:0}.iconbox{width:96px;height:96px;display:grid;place-items:center;overflow:hidden;border:1px solid rgba(168,85,247,.6);border-radius:19px;background:radial-gradient(circle at 30% 10%,rgba(168,85,247,.17),transparent 65%),linear-gradient(145deg,#1b1129,#0b0812);box-shadow:inset 0 0 18px rgba(124,58,237,.07)}.iconbox img{width:100%;height:100%;object-fit:contain;padding:10px}.iconbox .letter{font-size:30px;font-weight:900;color:var(--bright)}.iconbox .planet{font-size:45px;filter:drop-shadow(0 0 12px rgba(181,103,255,.5))}.app-name{display:block;font-size:12px;line-height:1.3;margin-top:9px;overflow-wrap:anywhere;color:#eee2ff}.app-sub{display:block;font-size:10px;color:var(--muted);margin-top:4px;line-height:1.3}.gear{position:absolute;right:-4px;top:-4px;width:28px;height:28px;border:1px solid #8150aa;background:#170d24;border-radius:50%;font-size:14px;z-index:2}.bottom-actions{display:grid;grid-template-columns:1fr;max-width:420px;margin:36px auto 10px}.primary-tile{min-height:70px;display:flex;align-items:center;justify-content:center;gap:13px;border:1px solid var(--purple);border-radius:19px;background:linear-gradient(110deg,#20112f,#100918);box-shadow:0 0 20px rgba(168,85,247,.12);font-weight:750}.primary-tile .tile-icon{font-size:25px;color:var(--bright)}.footer{text-align:center;color:#615371;font-size:11px;padding:20px 0 4px}.modal-backdrop{display:none;position:fixed;inset:0;z-index:30;background:rgba(3,2,8,.84);backdrop-filter:blur(10px);padding:16px;overflow:auto;align-items:center;justify-content:center}.modal-backdrop.open{display:flex}.modal{width:min(620px,100%);max-height:90vh;overflow:auto;border:1px solid var(--line);border-radius:22px;background:linear-gradient(145deg,#1b1129,#0b0812);box-shadow:0 0 50px rgba(124,58,237,.18);padding:20px}.modal-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}.modal-head h2{font-size:20px;margin:0}.close{width:38px;height:38px;border:1px solid #57376e;background:#140d1e;border-radius:12px;font-size:22px;color:var(--bright)}.setting-row{display:flex;align-items:center;justify-content:space-between;gap:18px;padding:15px 0;border-top:1px solid rgba(168,85,247,.18)}.setting-row strong{display:block;font-size:14px}.setting-row small{display:block;color:var(--muted);font-size:11px;line-height:1.45;margin-top:4px}.switch{width:46px;height:26px;flex-shrink:0;accent-color:#a855f7}.range{width:125px;accent-color:#a855f7}.primary,.secondary{padding:11px 14px;border-radius:12px;font-weight:700}.primary{border:1px solid #a855f7;background:#6d28d9}.secondary{border:1px solid #55396b;background:#170e23}.actions{display:flex;justify-content:flex-end;gap:9px;flex-wrap:wrap;margin-top:19px}.field-label{display:block;font-weight:700;font-size:13px;margin:16px 0 7px}.select{width:100%;padding:12px;border:1px solid #68438c;border-radius:12px;background:#100b1d;color:var(--text)}.small-note{font-size:12px;color:var(--muted);line-height:1.5;margin:14px 0}.all-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(94px,1fr));gap:20px 9px}.toast{position:fixed;z-index:50;left:50%;bottom:25px;transform:translate(-50%,16px);opacity:0;pointer-events:none;transition:.2s;background:#1b1129;border:1px solid var(--line);border-radius:12px;padding:11px 15px;color:var(--text);font-size:12px;text-align:center;max-width:90vw}.toast.show{opacity:1;transform:translate(-50%,0)}#loading{position:fixed;inset:0;z-index:100;display:flex;align-items:center;justify-content:center;flex-direction:column;background:radial-gradient(ellipse at center,rgba(87,30,158,.2),transparent 40%),#07050c;transition:opacity .3s ease,visibility .3s ease}#loading.done{opacity:0;visibility:hidden;pointer-events:none}.splash-cover{display:block;width:min(72vw,290px);height:min(72vw,290px);object-fit:contain;border-radius:16px;box-shadow:0 0 44px rgba(70,45,180,.14)}.splash-logo{font-size:clamp(90px,18vw,150px);font-weight:1000;font-style:italic;letter-spacing:-.12em;padding-right:.12em;color:#eedaff;text-shadow:0 0 10px #fff,0 0 28px #a855f7,0 0 60px rgba(124,58,237,.9)}.ring{width:102px;height:102px;border-radius:50%;display:grid;place-items:center;margin-top:28px;position:relative;background:conic-gradient(var(--bright) 0deg,rgba(168,85,247,.12) 0deg);box-shadow:0 0 28px rgba(168,85,247,.2)}.ring:before{content:"";position:absolute;inset:7px;background:#090610;border-radius:50%}.ring span{position:relative;font-size:22px;color:var(--bright)}.splash-text{margin-top:20px;font-size:15px;color:var(--bright)}.splash-sub{margin-top:7px;font-size:11px;color:#786a8e}body.no-motion *,body.no-motion *:before,body.no-motion *:after{animation:none!important;transition:none!important;scroll-behavior:auto!important}body.labels-hidden .app-name{display:none!important}@media(min-width:700px){.app-card{width:112px;flex-basis:112px}.iconbox{width:112px;height:112px}.frame{padding-top:28px}}@media(max-width:420px){.app-card{width:84px;flex-basis:84px}.iconbox{width:84px;height:84px;border-radius:17px}.status{font-size:10px;padding:7px 8px}.brand-mark{font-size:34px}.frame{padding-top:16px}}

/* Configurações avançadas */
.advanced-entry{border:1px solid rgba(168,85,247,.45);background:linear-gradient(110deg,rgba(109,40,217,.18),rgba(16,9,26,.82));border-radius:15px;padding:14px;margin:10px 0 14px;display:flex;align-items:center;justify-content:space-between;gap:14px}.advanced-entry strong{display:block;font-size:14px}.advanced-entry small{display:block;color:var(--muted);font-size:11px;line-height:1.45;margin-top:4px}.advanced-section{border-top:1px solid rgba(168,85,247,.22);padding-top:16px;margin-top:17px}.advanced-section h3{font-size:14px;margin:0 0 10px;color:#ead8ff}.stat-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.stat-card{border:1px solid rgba(168,85,247,.28);background:rgba(10,7,17,.68);border-radius:15px;padding:13px;min-width:0}.stat-card small{display:block;color:var(--muted);font-size:11px}.stat-card strong{display:block;font-size:19px;margin-top:6px;overflow-wrap:anywhere}.status-line{font-size:12px;line-height:1.5;color:var(--muted);padding:10px 12px;background:rgba(9,6,15,.65);border:1px solid rgba(168,85,247,.2);border-radius:12px;margin:10px 0}.button-row{display:flex;gap:8px;flex-wrap:wrap;margin-top:11px}.button-row button{flex:1 1 135px}.usage-list{display:grid;gap:11px;margin-top:13px}.usage-item{min-width:0}.usage-label{display:flex;justify-content:space-between;gap:10px;font-size:11px;margin-bottom:5px}.usage-label span:first-child{overflow-wrap:anywhere}.usage-label span:last-child{white-space:nowrap;color:#d9b5ff}.usage-track{height:7px;border-radius:99px;background:#241730;overflow:hidden}.usage-fill{height:100%;border-radius:99px;background:linear-gradient(90deg,#7c3aed,#d8a4ff);width:0}.advanced-note{font-size:11px;line-height:1.5;color:var(--muted);margin:9px 0 0}.danger-note{color:#e7c7a5}


/* X1 System + capa fornecida */
.x1-cover-banner{display:flex;justify-content:center;align-items:center;margin:0 0 14px;padding:8px 12px;min-height:126px;overflow:hidden;border:1px solid rgba(168,85,247,.28);border-radius:18px;background:#00152b;box-shadow:0 10px 32px rgba(5,7,40,.25)}
.x1-cover-banner img{display:block;width:min(100%,150px);height:150px;object-fit:contain;border-radius:10px}
.x1-tabs{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:0 0 20px;padding:5px;border:1px solid var(--line);border-radius:15px;background:rgba(10,7,17,.85)}
.x1-tab{min-height:43px;border:1px solid transparent;border-radius:11px;background:transparent;color:var(--muted);font-size:13px;font-weight:800}
.x1-tab.active{color:#fff;background:linear-gradient(110deg,#6d28d9,#3b1a67);border-color:#a855f7;box-shadow:0 0 16px rgba(168,85,247,.2)}
.page{display:none}.page.active{display:block}
.system-hero{padding:17px;margin:0 0 14px;border:1px solid rgba(168,85,247,.4);border-radius:18px;background:linear-gradient(125deg,rgba(40,22,66,.94),rgba(8,6,15,.97))}
.system-hero h2{margin:0 0 7px;font-size:21px}.system-hero p{margin:0;color:var(--muted);font-size:12px;line-height:1.55}
.system-group{margin:18px 0 23px}.system-group h3{margin:0 0 10px;font-size:15px;color:#ead8ff}.system-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.system-card{min-width:0;padding:13px;border:1px solid rgba(168,85,247,.28);border-radius:15px;background:linear-gradient(145deg,rgba(25,16,39,.94),rgba(9,7,15,.96))}.system-card small{display:block;color:var(--muted);font-size:11px}.system-card strong{display:block;margin-top:7px;font-size:16px;overflow-wrap:anywhere}.system-card p{margin:6px 0 0;color:var(--muted);font-size:10px;line-height:1.45;overflow-wrap:anywhere}
.system-actions{display:grid;grid-template-columns:1fr;gap:9px}.system-action{display:flex;align-items:center;justify-content:space-between;gap:12px;text-align:left;min-height:58px;padding:12px 14px;border:1px solid rgba(168,85,247,.34);border-radius:14px;background:rgba(17,11,27,.9)}.system-action span:first-child{font-size:13px;font-weight:750}.system-action small{display:block;margin-top:4px;color:var(--muted);font-size:10px;line-height:1.4;font-weight:400}.system-action .arrow{color:var(--bright);font-size:20px;flex-shrink:0}
.system-status{border:1px solid rgba(168,85,247,.24);border-radius:13px;background:rgba(5,4,10,.6);padding:12px;color:var(--muted);font-size:11px;line-height:1.55}
@media(min-width:650px){.x1-cover-banner{min-height:160px}.x1-cover-banner img{height:180px}.system-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.system-actions{grid-template-columns:1fr 1fr}}


/* Correção de navegação: abas sempre acessíveis ao rolar a página */
.x1-tabs{position:sticky;top:0;z-index:25;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);padding-top:6px;padding-bottom:6px;background:rgba(8,6,15,.94)}
.system-back{display:inline-flex;align-items:center;justify-content:center;margin-top:12px;min-height:42px;padding:9px 13px;border:1px solid rgba(168,85,247,.55);border-radius:11px;background:rgba(109,40,217,.18);color:#f8f4ff;font-weight:750;font-size:12px}


/* ADB wireless pairing controls */
.adb-pair-panel{margin-top:12px;padding:13px;border:1px solid rgba(168,85,247,.32);border-radius:14px;background:rgba(7,5,13,.72)}
.adb-paired-banner{margin-top:12px;padding:15px;border:1px solid rgba(34,197,94,.65);border-radius:14px;background:linear-gradient(125deg,rgba(20,83,45,.42),rgba(6,25,17,.92));color:#dcfce7;box-shadow:0 0 18px rgba(34,197,94,.10)}
.adb-paired-banner[hidden],.adb-pair-panel[hidden]{display:none!important}
.adb-paired-banner strong{display:block;font-size:15px;color:#86efac}
.adb-paired-banner p{font-size:12px;line-height:1.5;margin:8px 0 12px;color:#d1fae5}
.adb-paired-banner button{width:100%;min-height:42px;border:1px solid rgba(74,222,128,.42);border-radius:10px;background:rgba(20,83,45,.35);color:#dcfce7;font-weight:700}
.adb-label{display:block;margin:10px 0 5px;color:#e8d9ff;font-size:12px;font-weight:700}
.adb-input{box-sizing:border-box;width:100%;min-height:44px;padding:10px 12px;border:1px solid rgba(168,85,247,.42);border-radius:10px;background:#0d0915;color:#fff;font-size:14px;outline:none}
.adb-input:focus{border-color:#b68aff;box-shadow:0 0 0 2px rgba(168,85,247,.16)}
.adb-fields-row{display:grid;grid-template-columns:1fr 1fr;gap:9px}.adb-pair-panel button{width:100%;margin-top:10px;min-height:44px}

</style>
</head>
<body>
<div id="loading" aria-live="polite"><img class="splash-cover" src="x1-cover.jpg" alt="Capa X1"><div class="ring" id="splashRing"><span id="splashPercent">0%</span></div><div class="splash-text" id="splashText">Iniciando X1 Launcher...</div><div class="splash-sub">Preparando interface</div></div>
<script id="x1SplashFailsafe">
/* Proteção independente: a splash some mesmo se o script principal tiver erro. */
(function(){var start=Date.now(),done=false;function hide(){if(done)return;done=true;var el=document.getElementById('loading');if(el)el.classList.add('done');}function tick(){var p=Math.min(100,Math.floor((Date.now()-start)/24));var n=document.getElementById('splashPercent'),r=document.getElementById('splashRing'),t=document.getElementById('splashText');if(n)n.textContent=p+'%';if(r)r.style.background='conic-gradient(var(--bright) 0deg '+(p*3.6)+'deg,rgba(168,85,247,.12) '+(p*3.6)+'deg 360deg)';if(t)t.textContent=p<30?'Inicializando interface...':p<65?'Organizando aplicativos...':p<95?'Aplicando preferências...':'Launcher pronto';if(p>=100){hide();return;}setTimeout(tick,45);}setTimeout(tick,50);setTimeout(hide,2600);})();
</script>
<div class="frame">
<header><div class="brand"><div class="brand-mark">X1</div><div><div class="brand-title">LAUNCHER</div><div class="brand-sub">SEU ESPAÇO GAMER</div></div></div><div class="status"><i></i>Interface pronta</div></header>
<div class="x1-cover-banner"><img src="x1-cover.jpg" alt="Capa X1"></div>
<nav class="x1-tabs" aria-label="Navegação X1"><button class="x1-tab active" type="button" data-x1page="appsPage" aria-pressed="true">🎮 X1 Apps</button><button class="x1-tab" type="button" data-x1page="systemPage" aria-pressed="false">⚙ X1 System</button></nav>
<main id="appsPage" class="page active">
<section class="section"><div class="section-head"><div class="section-title"><span class="emoji">↻</span>Jogos abertos recentemente</div><button class="link-button" id="clearRecent">Limpar</button></div><p class="note">Os apps entram aqui quando você os abre pelo X1.</p><div class="rail-wrap"><div class="rail" id="recentRail"><div class="empty">Você ainda não abriu apps pelo X1.</div></div></div></section>
<section class="section"><div class="section-head"><div class="section-title"><span class="emoji">🎮</span>Jogos e apps instalados</div><button class="link-button" id="refreshInstalled">Atualizar ↻</button></div><p class="note">Toque em um ícone para abrir o aplicativo. A engrenagem salva preferências por app.</p><div class="rail-wrap"><div class="rail" id="installedRail"><div class="empty">Carregando aplicativos...</div></div></div></section>
<section class="section"><div class="section-head"><div class="section-title"><span class="emoji">⬇</span>Ports e Apps para Testar</div><button class="link-button" id="viewPorts">Ver todos →</button></div><p class="note">Os links abrem páginas externas. Confira a origem e a compatibilidade antes de instalar qualquer arquivo.</p><div class="rail-wrap"><div class="rail" id="portsRail"></div></div></section>
<div class="bottom-actions"><button class="primary-tile" id="openSettings"><span class="tile-icon">⚙</span>Configurações</button></div>
</main>
<section id="systemPage" class="page" aria-label="X1 System">
  <div class="system-hero"><h2>⚙ X1 System</h2><p>Diagnóstico do aparelho e atalhos reais do Android. Os dados são consultados quando esta página é aberta; recursos não expostos pelo Android aparecem como indisponíveis.</p><button type="button" class="system-back" id="systemBackToApps">← Voltar para X1 Apps</button></div>
  <div class="system-group"><h3>Depuração sem fio</h3><div class="system-status" id="wirelessStatus">O X1 pode receber o código pela notificação e descobrir as portas ADB por mDNS, sem preenchê-las manualmente. Ative Depuração sem fio no Android 11+.</div>
    <div class="adb-paired-banner" id="adbPairedBanner" hidden role="status" aria-live="polite">
      <strong>✓ Pareamento ADB ativado</strong>
      <p id="adbPairedDescription">O X1 salvou o estado do pareamento neste aplicativo.</p>
      <button type="button" id="adbForgetPairingButton">Configurar pareamento novamente</button>
    </div>
    <div class="adb-pair-panel" id="adbPairPanel">
      <p class="note">Ative a Depuração sem fio no Android. O modo automático permite responder ao aviso do X1 com o código de 6 dígitos, sem preencher IP ou portas.</p>
      <button type="button" class="primary" id="adbNotifyPairButton">Parear pela notificação (sem IP/porta)</button>
      <p class="note">Abra “Parear dispositivo com código” no Android. Quando o aviso do X1 aparecer, responda com o código temporário. O X1 tentará descobrir os endereços automaticamente.</p>
      <details class="adb-manual-details"><summary>Configuração manual / avançada</summary>
      <p class="note">Use o modo manual apenas se a descoberta automática não funcionar. O IP e as portas temporárias mudam e devem ser copiados da tela atual do Android.</p>
      <label class="adb-label" for="adbHost">IP do dispositivo</label><input id="adbHost" class="adb-input" type="text" inputmode="url" autocomplete="off" placeholder="192.168.1.100">
      <div class="adb-fields-row"><div><label class="adb-label" for="adbPairPort">Porta de pareamento</label><input id="adbPairPort" class="adb-input" type="number" inputmode="numeric" min="1" max="65535" placeholder="Ex.: 37625"></div><div><label class="adb-label" for="adbPairCode">Código de 6 dígitos</label><input id="adbPairCode" class="adb-input" type="password" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="123456"></div></div>
      <label class="adb-label" for="adbConnectPort">Porta de conexão (opcional)</label><input id="adbConnectPort" class="adb-input" type="number" inputmode="numeric" min="1" max="65535" placeholder="Porta mostrada na tela principal de Depuração sem fio">
      <button type="button" class="primary" id="adbPairButton">Parear dispositivo</button>
      <button type="button" class="secondary" id="adbConnectButton">Conectar dispositivo já pareado</button>
      </details>
    </div>

    <div class="button-row"><button class="primary" id="openWirelessDebugging">Abrir opções do desenvolvedor ↗</button><button class="secondary" id="wirelessHelp">Como ativar</button></div>
  </div>
  <div class="system-group"><h3>Monitoramento</h3><div class="system-grid">
    <div class="system-card"><small>RAM usada / total</small><strong id="systemRamValue">—</strong><p id="systemRamDetail">Consultando Android…</p></div>
    <div class="system-card"><small>Armazenamento livre</small><strong id="systemStorageValue">—</strong><p id="systemStorageDetail">Consultando Android…</p></div>
    <div class="system-card"><small>Temperatura da bateria</small><strong id="systemTempValue">—</strong><p>Temperatura da bateria reportada pelo Android; não é a temperatura interna da CPU/GPU.</p></div>
  </div></div>
  <div class="system-group"><h3>Dispositivo</h3><div class="system-grid">
    <div class="system-card"><small>Modelo</small><strong id="systemDeviceValue">—</strong><p id="systemAndroidValue">Versão do Android: —</p></div>
    <div class="system-card"><small>CPU / SoC</small><strong id="systemCpuValue">—</strong><p id="systemAbiValue">ABI: —</p></div>
